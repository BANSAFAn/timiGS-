---
import { Language } from '../i18n/types';
import { useTranslations } from '../i18n/utils';
import Sidebar from '../components/Sidebar';
import Footer from '../components/Footer';
import SEOHead from '../components/SEOHead.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
const { lang } = Astro.params; 
const currentLang = (lang as Language) || Language.EN;
const t = useTranslations(currentLang);
const pathname = Astro.url.pathname;
const dir = currentLang === Language.AR ? 'rtl' : 'ltr';
---

<!doctype html>
<html lang={currentLang} dir={dir} class="scroll-smooth">
	<head>
        <SEOHead title={title} />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
        <meta name="theme-color" content="#0ea5e9" />
        <meta name="mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
        <style is:global>
            /* ═══════════════════════════════════════════ */
            /*  MODERN DESIGN SYSTEM — TimiGS             */
            /* ═══════════════════════════════════════════ */
            
            :root {
                --bg-primary: #020502;
                --bg-secondary: #081008;
                --bg-tertiary: #0e1a0e;
                --surface: #081008;
                --border: rgba(57, 255, 20, 0.25);
                --border-light: rgba(57, 255, 20, 0.15);
                --brand-primary: #39ff14;
                --brand-secondary: #10b981;
                --text-primary: #39ff14;
                --text-secondary: #22c55e;
                --text-tertiary: #166534;
                --accent-purple: #39ff14;
                --accent-pink: #39ff14;
                --accent-orange: #ffb300;
                --accent-green: #39ff14;
                --sidebar-width: 300px;
                --header-height: 64px;
                --font-family: 'Consolas', 'Courier New', 'JetBrains Mono', monospace;
            }
            
            @media (prefers-color-scheme: light) {
                :root {
                    --bg-primary: #0a0600;
                    --bg-secondary: #140d00;
                    --bg-tertiary: #1e1300;
                    --surface: #140d00;
                    --border: rgba(255, 179, 0, 0.25);
                    --border-light: rgba(255, 179, 0, 0.15);
                    --brand-primary: #ffb300;
                    --brand-secondary: #f59e0b;
                    --text-primary: #ffb300;
                    --text-secondary: #fbbf24;
                    --text-tertiary: #b45309;
                }
            }

            body {
                background: var(--bg-primary);
                color: var(--text-primary);
                font-family: var(--font-family);
                -webkit-font-smoothing: antialiased;
                -moz-osx-font-smoothing: grayscale;
                overflow-x: hidden;
                -webkit-tap-highlight-color: transparent;
            }

            * { 
                box-sizing: border-box; 
                border-radius: 0px !important;
            }

            ::selection {
                background: var(--brand-primary);
                color: var(--bg-primary);
            }

            /* ── Scrollbar ── */
            ::-webkit-scrollbar { width: 8px; height: 8px; }
            ::-webkit-scrollbar-track { background: var(--bg-secondary); }
            ::-webkit-scrollbar-thumb {
                background: var(--border);
                border-radius: 0px !important;
            }
            ::-webkit-scrollbar-thumb:hover {
                background: var(--brand-primary);
            }

            /* ── Typography ── */
            h1, h2, h3, h4, h5, h6 {
                font-family: var(--font-family);
                font-weight: 700;
                letter-spacing: -0.025em;
                color: var(--text-primary);
            }

            /* ── Code Syntax Highlighting & Inline Code ── */
            pre {
                background: var(--bg-secondary) !important;
                border: 1px solid var(--border) !important;
                border-radius: 0px !important;
                padding: 1.25rem !important;
                margin: 1.5rem 0 !important;
                overflow-x: auto;
            }
            pre code {
                font-family: var(--font-family) !important;
                font-size: 0.85rem !important;
                line-height: 1.6 !important;
                background: transparent !important;
                padding: 0 !important;
                border: none !important;
                color: var(--text-primary) !important;
            }
            code:not(pre code) {
                font-family: var(--font-family) !important;
                font-size: 0.85rem !important;
                background: var(--bg-tertiary) !important;
                color: var(--brand-primary) !important;
                padding: 0.15rem 0.35rem !important;
                border-radius: 0px !important;
                border: 1px solid var(--border) !important;
                word-break: break-word;
            }

            /* ── Card Components ── */
            .card {
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: 0px !important;
                transition: all 0.2s ease;
                position: relative;
                overflow: hidden;
            }
            .card:hover {
                border-color: var(--brand-primary);
                box-shadow: 0 0 15px rgba(57, 255, 20, 0.15);
                transform: translateY(-2px);
            }

            .glass-card {
                background: var(--bg-secondary);
                border: 1px solid var(--border);
                border-radius: 0px !important;
            }

            /* ── Badge Component ── */
            .badge {
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                padding: 0.5rem 1rem;
                border-radius: 0px !important;
                font-size: 0.875rem;
                font-weight: 600;
                background: var(--bg-tertiary);
                color: var(--brand-primary);
                border: 1px solid var(--border);
                font-family: var(--font-family);
            }

            /* ── Glitch Page Transition ── */
            .page-content {
                animation: glitch-enter 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
            }

            @keyframes glitch-enter {
                0% {
                    opacity: 0;
                    transform: translate(0) skew(0deg);
                    filter: hue-rotate(0deg);
                    clip-path: inset(0 0 0 0);
                }
                20% {
                    opacity: 0.8;
                    transform: translate(-6px, 2px) skew(-4deg);
                    filter: hue-rotate(90deg);
                    clip-path: inset(20% 0 30% 0);
                }
                40% {
                    opacity: 0.9;
                    transform: translate(5px, -2px) skew(3deg);
                    filter: hue-rotate(-90deg);
                    clip-path: inset(50% 0 10% 0);
                }
                60% {
                    opacity: 0.95;
                    transform: translate(-2px, 1px) skew(-1deg);
                    filter: hue-rotate(45deg);
                    clip-path: inset(10% 0 60% 0);
                }
                80% {
                    opacity: 1;
                    transform: translate(1px, 0) skew(0deg);
                    filter: hue-rotate(0deg);
                    clip-path: inset(0 0 0 0);
                }
                100% {
                    opacity: 1;
                    transform: translate(0) skew(0deg);
                    filter: hue-rotate(0deg);
                    clip-path: inset(0 0 0 0);
                }
            }

            /* ── Gradient Text ── */
            .gradient-text {
                color: var(--brand-primary);
            }

            /* ── Button Styles ── */
            .btn-primary {
                position: relative;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                padding: 0.875rem 1.75rem;
                background: var(--bg-tertiary);
                border: 1px solid var(--brand-primary);
                border-radius: 0px !important;
                color: var(--brand-primary);
                font-family: var(--font-family);
                font-weight: 700;
                font-size: 15px;
                cursor: pointer;
                transition: all 0.2s ease;
            }
            .btn-primary:hover {
                background: var(--brand-primary);
                color: var(--bg-primary);
                box-shadow: 0 0 20px rgba(57, 255, 20, 0.3);
            }
            .btn-primary:active {
                transform: translateY(0);
            }

            .btn-secondary {
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                padding: 0.875rem 1.75rem;
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: 0px !important;
                color: var(--text-primary);
                font-family: var(--font-family);
                font-weight: 600;
                font-size: 15px;
                cursor: pointer;
                transition: all 0.2s ease;
            }
            .btn-secondary:hover {
                background: var(--bg-secondary);
                border-color: var(--brand-primary);
                color: var(--brand-primary);
            }

            /* ── Mobile Performance ── */
            @media (max-width: 768px) {
                .animate-float, .animate-hex-float, .animate-pulse-slow {
                    animation: none !important;
                }
            }

            /* ── Touch-friendly ── */
            @media (max-width: 768px) {
                button, a { min-height: 44px; min-width: 44px; }
            }

            /* ── Reduce motion ── */
            @media (prefers-reduced-motion: reduce) {
                *, *::before, *::after {
                    animation-duration: 0.01ms !important;
                    animation-iteration-count: 1 !important;
                    transition-duration: 0.01ms !important;
                }
            }

            /* ── Google Translate Branding Cleanup ── */
            iframe.goog-te-banner-frame,
            iframe[class*="goog-te-banner"],
            .goog-te-banner-frame,
            #goog-gt-tt,
            .goog-te-balloon-frame,
            body > .skiptranslate {
                display: none !important;
                visibility: hidden !important;
                opacity: 0 !important;
                height: 0 !important;
                width: 0 !important;
            }
            body {
                top: 0 !important;
                position: static !important;
            }
            html {
                padding-top: 0 !important;
                top: 0 !important;
                margin-top: 0 !important;
            }
            .goog-text-highlight {
                background: transparent !important;
                box-shadow: none !important;
            }

            /* ── Global Hacker Theme & Prose Overrides ── */
            body, main, div, section, header, footer, article, nav, aside {
                font-family: var(--font-family) !important;
            }

            .prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
                color: var(--brand-primary) !important;
                font-family: var(--font-family) !important;
            }

            .prose p, .prose li, .prose td, .prose th, .prose span, .prose blockquote {
                color: var(--text-secondary) !important;
                font-family: var(--font-family) !important;
            }

            .prose a {
                color: var(--brand-primary) !important;
                text-decoration: underline !important;
            }

            .prose strong, .prose b {
                color: var(--brand-primary) !important;
            }

            .prose table, .prose th, .prose td {
                border: 1px solid var(--border) !important;
            }

            .prose code {
                color: var(--brand-primary) !important;
                background: var(--bg-tertiary) !important;
                border: 1px solid var(--border) !important;
                border-radius: 0px !important;
            }

            .prose pre {
                background: var(--bg-secondary) !important;
                border: 1px solid var(--border) !important;
                border-radius: 0px !important;
            }

            .text-gray-900, .text-gray-800, .text-gray-700, .text-white, .text-slate-100, .text-slate-200 {
                color: var(--brand-primary) !important;
            }

            .text-gray-600, .text-gray-500, .text-gray-400, .text-slate-300, .text-slate-400 {
                color: var(--text-secondary) !important;
            }

            .bg-slate-900, .bg-slate-950, .bg-slate-800, .bg-white, .bg-gray-50, .bg-gray-100, .bg-slate-900\/95, .bg-white\/95 {
                background-color: var(--bg-secondary) !important;
            }

            .border-slate-800, .border-slate-700, .border-gray-200, .border-gray-100, .border-gray-300 {
                border-color: var(--border) !important;
            }
        </style>
	</head>
	<body class="min-h-screen flex flex-col relative">

        <!-- Cyber Background -->
        <div class="fixed inset-0 -z-10 pointer-events-none overflow-hidden" aria-hidden="true">
            <!-- Terminal Grid pattern -->
            <div class="absolute inset-0 opacity-[0.05]" style="background-image: linear-gradient(var(--brand-primary) 1px, transparent 1px), linear-gradient(90deg, var(--brand-primary) 1px, transparent 1px); background-size: 40px 40px;"></div>
        </div>

		<Sidebar client:load lang={currentLang} t={t} pathname={pathname} />

        <!-- Content area -->
        <div class="flex flex-col min-h-screen">
            <main class="page-content flex-grow pt-16 md:pt-12 pb-16 sm:pb-20 px-4 sm:px-6 md:px-8 lg:px-16 max-w-7xl mx-auto w-full z-10">
	            <slot />
            </main>

            <Footer client:visible t={t} />
        </div>
	</body>
</html>
